PORT=3000
CLIENT_URL=http://localhost:5173
JWT_SECRET=generate_a_random_server_only_session_secret
# Supabase sessions are verified with Auth; a signing key ID is not a secret.
SUPABASE_JWT_SECRET=

# Supabase Credentials (required for production database writes)
SUPABASE_URL=https://your-project-ref.supabase.co
DATABASE_MODE=supabase
SUPABASE_SCHEMA_VARIANT=numbered
# Enable only on machines that require the OS certificate store (Node 22.19+/24+).
SUPABASE_USE_SYSTEM_CA=false
# Use the secret service_role key from Supabase Project Settings > API.
# Never use the sb_publishable_* key here and never expose this value to Vite.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_ANON_KEY=

# Commercial Target Defaults
MONTHLY_SALES_TARGET=10000000

# Model-written operational analysis uses OpenAI Responses API; otherwise live calculated insights remain available.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=

# Email / Notifications
RESEND_API_KEY=
EMAIL_FROM=notifications@edgewforce.com

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@edgewforce.com

# Biometric Facial Verification Settings
FACE_RECOGNITION_PROVIDER=INTERNAL_FACE_ENGINE
FACE_RECOGNITION_API_KEY=
FACE_MATCH_THRESHOLD=0.80
