# ==============================================================================
# EDGEWFORCE - PRODUCTION ENVIRONMENT CONFIGURATION (Vercel + Supabase)
# ==============================================================================

NODE_ENV=production
PORT=3000
CLIENT_URL=https://your-custom-domain.com

# JWT Secret for Session & API Token Signing
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters

# Supabase PostgreSQL & Cloud Services
# Obtain from: https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://your-project-ref.supabase.co
DATABASE_MODE=supabase
SUPABASE_SCHEMA_VARIANT=numbered
SUPABASE_USE_SYSTEM_CA=false
SUPABASE_ANON_KEY=your_supabase_publishable_key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Supabase Storage Bucket for Uploads (Default: edgewforce-media)
SUPABASE_STORAGE_BUCKET=edgewforce-media

# Paystack API Keys (Nigerian Commercial Payments)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxx

# Model-written operational analysis uses OpenAI Responses API; otherwise live calculated insights remain available.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=

# Email / Notifications (Resend / SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxx
EMAIL_FROM=operations@your-custom-domain.com

# Commercial Sales Defaults (NGN)
MONTHLY_SALES_TARGET=25000000
