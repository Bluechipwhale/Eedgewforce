# ==============================================================================
# EDGEWFORCE - PRODUCTION ENVIRONMENT CONFIGURATION (Hostinger)
# ==============================================================================

NODE_ENV=production
PORT=3000
CLIENT_URL=https://yourdomain.com
JWT_SECRET=replace_with_a_unique_random_application_secret
DATABASE_MODE=supabase
SUPABASE_SCHEMA_VARIANT=numbered
SUPABASE_USE_SYSTEM_CA=false

# Required for the online Vercel API. The service-role key lets the server read
# the complete staff directory while keeping Supabase RLS enabled for clients.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_key

# Paystack API Keys (Nigerian Commercial Payments)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxx

# AI Engine Provider (internal, openai, gemini, or anthropic)
AI_PROVIDER=internal
AI_API_KEY=

# Email / Notifications (Resend / SMTP)
RESEND_API_KEY=
EMAIL_FROM=operations@yourdomain.com

# Monthly Sales Target Default (NGN)
MONTHLY_SALES_TARGET=25000000
